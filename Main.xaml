<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rest Agent • Portable"
        Width="1280"
        Height="860"
        MinWidth="1000"
        MinHeight="700"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Geometry x:Key="IconHistory">M 2,5 A 6,6 0 1 1 2,11 M 1,1 L 1,5 L 5,5 M 8,4 L 8,8 L 11,10</Geometry>
        <Geometry x:Key="IconCollection">M 2,3 C 2,0 14,0 14,3 C 14,6 2,6 2,3 M 2,3 L 2,12 C 2,15 14,15 14,12 L 14,3 M 2,7 C 2,10 14,10 14,7</Geometry>
        <Geometry x:Key="IconRequest">M 3,1 L 10,1 L 14,5 L 14,15 L 3,15 Z M 10,1 L 10,5 L 14,5 M 6,8 L 10,10 L 6,12 Z</Geometry>
        <Geometry x:Key="IconFolder">M 1,4 L 1,2 L 6,2 L 8,4 L 15,4 L 15,14 L 1,14 Z M 1,6 L 15,6</Geometry>
        <Geometry x:Key="IconImport">M 8,1 L 8,10 M 4.5,6.5 L 8,10 L 11.5,6.5 M 2,10 L 2,14 L 14,14 L 14,10</Geometry>
        <Geometry x:Key="IconExport">M 8,10 L 8,1 M 4.5,4.5 L 8,1 L 11.5,4.5 M 2,10 L 2,14 L 14,14 L 14,10</Geometry>
        <Geometry x:Key="IconSettings">M 6,1 L 10,1 L 10.5,3 L 12,4 L 14,4 L 15,7 L 13.5,8 L 13,10 L 14,12 L 11.5,14 L 10,13 L 8,13.5 L 7,15 L 4,14 L 4,12 L 2.5,10.5 L 1,10 L 1,6 L 3,5.5 L 4,4 L 4,2 Z M 10.8,8 A 2.8,2.8 0 1 1 5.2,8 A 2.8,2.8 0 1 1 10.8,8</Geometry>
        <Geometry x:Key="IconRename">M 2,11 L 2,14 L 5,14 L 14,5 L 11,2 Z M 9,4 L 12,7</Geometry>
        <Geometry x:Key="IconCopy">M 5,5 L 14,5 L 14,15 L 5,15 Z M 11,5 L 11,1 L 1,1 L 1,11 L 5,11</Geometry>
        <Geometry x:Key="IconMove">M 1,9 L 12,9 M 8,5 L 12,9 L 8,13 M 3,5 L 3,2 L 15,2 L 15,14</Geometry>
        <Geometry x:Key="IconDelete">M 2,4 L 14,4 M 6,4 L 6,1 L 10,1 L 10,4 M 4,4 L 5,15 L 11,15 L 12,4 M 7,7 L 7,12 M 9,7 L 9,12</Geometry>
        <Geometry x:Key="IconSearch">M 11,6 A 5,5 0 1 1 1,6 A 5,5 0 1 1 11,6 M 10,10 L 15,15</Geometry>
        <Geometry x:Key="IconMore">M 8,2 A 0.7,0.7 0 1 0 8,3.4 A 0.7,0.7 0 1 0 8,2 M 8,7 A 0.7,0.7 0 1 0 8,8.4 A 0.7,0.7 0 1 0 8,7 M 8,12 A 0.7,0.7 0 1 0 8,13.4 A 0.7,0.7 0 1 0 8,12</Geometry>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F3F6"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#263347"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7A8798"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE2EA"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#E8EDF3"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#E8F0F5"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#F3F6F9"/>
        <SolidColorBrush x:Key="AlternateBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3F6D83"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#202C3C"/>
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#E7EDF5"/>
        <SolidColorBrush x:Key="SidebarMutedBrush" Color="#96A9BF"/>
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#293B50"/>
        <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#36546D"/>
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="#3A4656"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C04150"/>

        <Style x:Key="Card"
                TargetType="Border">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16"
                            ShadowDepth="2"
                            Opacity="0.07"
                            Color="#263347"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding"
                    Value="10,5"/>
            <Setter Property="Margin"
                    Value="0,0,8,0"/>
            <Setter Property="Background"
                    Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="B"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.8"
                                                    Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="B"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="B"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding"
                    Value="8,5"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource InputBrush}"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding"
                    Value="7,4"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding"
                    Value="10,6"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Margin="0,0,5,7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                    HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}"/>
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource ButtonBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Opacity"
                                        Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="AutoGenerateColumns"
                    Value="False"/>
            <Setter Property="CanUserAddRows"
                    Value="False"/>
            <Setter Property="HeadersVisibility"
                    Value="Column"/>
            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground"
                    Value="{DynamicResource AlternateBrush}"/>
        </Style>
     <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="8,5"/><Setter Property="Background" Value="{DynamicResource HeaderBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>

        <Style x:Key="SidebarTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/><Setter Property="Padding" Value="10,5"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="LibraryItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
                <StackPanel>
                    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Margin="0,2" Padding="4,5">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="Expander" Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Width="18" Height="24"><Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8" Stroke="{DynamicResource SidebarMutedBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ItemsPresenter x:Name="Children" Margin="16,0,0,0"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed"/></Trigger>
                    <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HistoryItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="8,10" Margin="0,2" CornerRadius="6" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="EditorInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ValueInput" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28"/><Setter Property="MaxDropDownHeight" Value="260"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Choice" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5"/>
                    <TextBox x:Name="PART_EditableTextBox" Margin="8,3,30,3" Padding="0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                    <ToggleButton x:Name="ValueDropDown" Width="28" HorizontalAlignment="Right" Margin="1" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
                    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0"><ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup>
                </Grid><ControlTemplate.Triggers><Trigger Property="HasItems" Value="False"><Setter TargetName="ValueDropDown" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Margin" Value="8,3,8,3"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CatalogItem" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Option" Padding="12,9" Margin="3,1" CornerRadius="5" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="LibraryMenuSeparator" TargetType="Separator">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource ButtonBrush}" Margin="10,5"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LibraryMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Grid>
                    <Border x:Name="MenuRow" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="2,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="11"/>
                            <Path x:Name="SubmenuArrow" Grid.Column="3" Data="M 0 0 L 4 4 L 0 8" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="3" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="8" MinWidth="220">
                            <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.14"/></Border.Effect>
                            <ScrollViewer MaxHeight="440" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="HasItems" Value="True"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LibraryContextMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="8" MinWidth="230">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.14"/></Border.Effect>
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
        <Style x:Key="SidebarNavigation" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Nav" Background="{TemplateBinding Background}"><Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,12"/><Border x:Name="Underline" Height="2" Background="Transparent" VerticalAlignment="Bottom" Margin="7,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Underline" Property="Background" Value="{DynamicResource SidebarTextBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SidebarAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}"/><Setter Property="Padding" Value="7,4"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0"/><Setter Property="Height" Value="29"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Action" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Action" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
 </Window.Resources>
    <Grid x:Name="WorkspaceLayout" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="220" MaxWidth="520"/>
            <ColumnDefinition x:Name="SplitterColumn" Width="6"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Background="{DynamicResource SidebarBrush}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="SidebarBrand" Padding="14,12" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Image x:Name="SidebarLogo" Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="SidebarAppName" Text="REST AGENT" Foreground="{DynamicResource SidebarTextBrush}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="PORTABLE API WORKSPACE" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="9" Margin="0,3,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1"><UniformGrid Columns="2"><RadioButton GroupName="SidebarNavigation" x:Name="HistoryNavigation" Style="{StaticResource SidebarNavigation}" IsChecked="{Binding IsSelected, ElementName=HistorySidebarTab, Mode=TwoWay}"/><RadioButton GroupName="SidebarNavigation" x:Name="CollectionNavigation" Style="{StaticResource SidebarNavigation}" IsChecked="{Binding IsSelected, ElementName=CollectionSidebarTab, Mode=TwoWay}"/></UniformGrid></Border>
                <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1" Padding="9,7">
                        <Grid><TextBox x:Name="Search" Style="{StaticResource EditorInput}" Background="{DynamicResource SidebarBrush}" Foreground="{DynamicResource SidebarTextBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0" Padding="27,3,24,3" ToolTip="Поиск по имени, методу и URL"/>
                            <Path Data="{StaticResource IconSearch}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource SidebarMutedBrush}" StrokeThickness="1.4" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="Поиск…" Foreground="{DynamicResource SidebarMutedBrush}" Margin="27,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <Button x:Name="ClearSearch" Content="×" ToolTip="Очистить поиск" HorizontalAlignment="Right" Padding="6,0" Margin="0" Background="Transparent" Foreground="{DynamicResource SidebarMutedBrush}"/>
                        </Grid>
                    </Border>
                    <TabControl x:Name="LibraryTabs" Grid.Row="1" SelectedIndex="1" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="6,8,6,0">
                        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
                        <TabItem x:Name="HistorySidebarTab" Header="История"><Grid><ListBox x:Name="History" Background="Transparent" Foreground="{DynamicResource SidebarTextBrush}" BorderThickness="0" ItemContainerStyle="{StaticResource HistoryItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Method}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="HistoryEmpty" Text="История появится после первого запроса." Foreground="{DynamicResource SidebarMutedBrush}" TextWrapping="Wrap" Margin="12,12" VerticalAlignment="Top" IsHitTestVisible="False"/></Grid></TabItem>
                        <TabItem x:Name="CollectionSidebarTab" Header="Коллекция"><Grid><TreeView x:Name="Library" Background="Transparent" Foreground="{DynamicResource SidebarTextBrush}" BorderThickness="0" Padding="0,3" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><TextBlock x:Name="LibraryEmpty" Text="Пока нет сохранённых запросов.&#10;Создайте каталог или сохраните запрос." Foreground="{DynamicResource SidebarMutedBrush}" TextWrapping="Wrap" Margin="8,45,8,0" VerticalAlignment="Top" IsHitTestVisible="False"/><Button x:Name="RenameItem" Content="Переименовать" Visibility="Collapsed"/><Button x:Name="ItemActions" Visibility="Collapsed"/></Grid></TabItem>
                    </TabControl>
                </Grid>
                <Border Grid.Row="3" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,1,0,0" Padding="9,8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="36"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                        <Button x:Name="Import" Style="{StaticResource SidebarAction}" ToolTip="Импорт коллекции"/><Button x:Name="Export" Grid.Column="1" Style="{StaticResource SidebarAction}" ToolTip="Экспорт коллекции"/>
                        <Button x:Name="NewRequest" Grid.Row="1" Style="{StaticResource SidebarAction}" BorderThickness="1" ToolTip="Новый запрос в выбранном каталоге"/>
                        <Button x:Name="NewFolder" Grid.Row="1" Grid.Column="1" Style="{StaticResource SidebarAction}" BorderThickness="1" ToolTip="Новый каталог в выбранном каталоге"/>
                        <Button x:Name="Settings" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource SidebarAction}" ToolTip="Темы и настройки приложения"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Cursor="SizeWE" Background="{DynamicResource BorderBrush}" ToolTip="Изменить ширину панели">
            <GridSplitter.Style><Style TargetType="GridSplitter"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter"><Border x:Name="Divider" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger></Style.Triggers></Style></GridSplitter.Style>
        </GridSplitter>
        <Grid Grid.Column="2"
                Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="280" MinHeight="190"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ToggleSidebar" Content="☰" Padding="9,6" Margin="0,3,10,0" VerticalAlignment="Top" ToolTip="Скрыть/показать панель коллекций (Ctrl+B)"/>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <Grid x:Name="TitleRow"><StackPanel Orientation="Horizontal">
                    <TextBlock TextTrimming="CharacterEllipsis" x:Name="RequestTitle" Cursor="Hand" ToolTip="Изменить название запроса"
                            Text="Новый запрос"
                            FontSize="23"
                            FontWeight="SemiBold"/>
                    <Button x:Name="RenameTitle" Content="✎" Margin="5,0,0,0" Padding="6,4" Background="Transparent" ToolTip="Изменить название запроса"/>
                    </StackPanel>
                    <TextBox x:Name="RequestTitleEditor" Style="{StaticResource EditorInput}" FontSize="21" FontWeight="SemiBold" Padding="5,2" Visibility="Collapsed" ToolTip="Enter — сохранить название, Esc — отменить"/>
                    </Grid>
                    <TextBlock Text="Соберите запрос. Исследуйте ответ."
                            Foreground="{DynamicResource MutedBrush}"
                            Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="Save"
                            Content="Сохранить"/>
                    <Button x:Name="Send"
                            Content="Отправить →"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentTextBrush}"/>
                    <Button x:Name="Cancel"
                            Content="Отмена"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Style="{StaticResource ValueInput}" IsEditable="True" IsReadOnly="True" x:Name="Method"
                            SelectedIndex="0">
                        <ComboBoxItem Content="GET"/>
                        <ComboBoxItem Content="POST"/>
                        <ComboBoxItem Content="PUT"/>
                        <ComboBoxItem Content="PATCH"/>
                        <ComboBoxItem Content="DELETE"/>
                        <ComboBoxItem Content="HEAD"/>
                        <ComboBoxItem Content="OPTIONS"/>
                    </ComboBox>
                    <TextBox Grid.Column="1"
                            Style="{StaticResource EditorInput}" ToolTip="Полный URL. Параметры синхронизируются с таблицей." x:Name="Url"
                            Margin="12,0"
                            Text="https://httpbin.org/get"/>
                    <TextBox Grid.Column="2"
                            Style="{StaticResource EditorInput}" x:Name="Timeout"
                            Text="30"
                            ToolTip="Таймаут, секунды"/>
                </Grid>
            </Border>
            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="10"
                    Padding="10">
                <TabControl x:Name="RequestTabs" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <TabItem Header="Заголовки">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    Margin="0,10,0,0">
                                <Button x:Name="AddHeader"
                                        Content="＋ Из каталога"/>
                                <Button x:Name="AddEmptyHeader" Content="Своя строка"/><Button x:Name="RemoveHeader" Visibility="Collapsed"
                                        Content="Удалить"/>
                                <Button x:Name="Bearer"
                                        Content="Bearer token"/>
                            </StackPanel>
                            <DataGrid x:Name="Headers">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Вкл." Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Включить заголовок в запрос"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Имя"
                                            Width="2*"
                                            MinWidth="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,3"><TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}" Padding="8,4,32,4" ToolTip="Имя заголовка; ⋯ открывает каталог"/><Button x:Name="ChooseHeaderName" Content="⋯" ToolTip="Выбрать заголовок из каталога" Margin="0,2,2,2" Padding="7,2" HorizontalAlignment="Right" Background="Transparent"/></Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Значение" Width="3*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding ValueSuggestions}" IsEditable="True" IsTextSearchEnabled="False" Style="{StaticResource ValueInput}" Margin="4,3" ToolTip="Значение можно ввести или выбрать из подсказок"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="34"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button x:Name="DeleteHeaderRow" Content="×" Padding="6,3" Margin="0" Background="Transparent" ToolTip="Удалить заголовок"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Параметры">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="AddQuery" Content="＋ Из списка"/>
                                <Button x:Name="AddEmptyQuery" Content="Своя строка"/>
                                <Button x:Name="CopyUrl" Content="Копировать URL" ToolTip="Скопировать полный адрес с включёнными параметрами"/>
                                <Button x:Name="RemoveQuery" Content="Удалить" Visibility="Collapsed"/>
                            </StackPanel>
                            <DataGrid x:Name="Queries">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Вкл." Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Включить параметр в URL"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Имя" Width="2*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Grid Margin="4,3"><TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}" Padding="8,4,32,4" ToolTip="Имя параметра; ⋯ открывает список"/><Button x:Name="ChooseQueryName" Content="⋯" ToolTip="Выбрать параметр" Margin="0,2,2,2" Padding="7,2" HorizontalAlignment="Right" Background="Transparent"/></Grid>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Значение" Width="3*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorInput}" Margin="4,3" ToolTip="Введите обычный текст; символы для URL кодируются автоматически"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="30"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button x:Name="DeleteQueryRow" Content="×" Padding="6,3" Margin="0" Background="Transparent" ToolTip="Удалить параметр"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Тело запроса">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button x:Name="FormatRequest" Content="Форматировать"/>
                                <TextBlock Text="Тип содержимого задаётся заголовком Content-Type" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                            </WrapPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock x:Name="RequestLanguage" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                <ComboBox x:Name="RequestSyntax" Style="{StaticResource ValueInput}" IsEditable="True" IsReadOnly="True" Width="120" HorizontalAlignment="Right" ToolTip="Подсветка синтаксиса. Авто — по содержимому и Content-Type"/>
                            </Grid>
                            <TextBox x:Name="Body" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" VerticalContentAlignment="Top"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
            <GridSplitter Grid.Row="3"
                    Height="5"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"/>
            <Border Grid.Row="4"
                    Style="{StaticResource Card}"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="10"
                    Padding="14">
                <DockPanel>
                    <Border x:Name="ResponseStatusBand" DockPanel.Dock="Top" Margin="-14,-14,-14,10" Padding="14,10" CornerRadius="10,10,0,0" Background="{DynamicResource ButtonBrush}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ResponseStatus" Text="Ответ" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ResponseMeta" Grid.Column="1" Margin="16,0,0,0" Text="Отправьте запрос, чтобы увидеть результат" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock x:Name="RequestAddress" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,2,6,0"/></Style>
                        </WrapPanel.Resources>
                        <Button x:Name="ResponseTop" Content="↑ В начало" ToolTip="Прокрутить ответ к началу"/>
                        <Button x:Name="ResponseBottom" Content="↓ В конец" ToolTip="Прокрутить ответ к концу"/>
                        <Button x:Name="CollapseResponse" Content="⊟ Свернуть всё" IsEnabled="False" ToolTip="Свернуть все вложенные блоки. Полный текст сохранится"/>
                        <Button x:Name="ExpandResponse" Content="⊞ Развернуть всё" IsEnabled="False" ToolTip="Развернуть все вложенные блоки"/>
                        <Button x:Name="GroupResponse" Content="▤ Группы" IsEnabled="False" ToolTip="Показать элементы массивов JSON свёрнутыми строками с кратким содержимым"/>
                        <Button x:Name="FormatResponse" Content="Форматировать"/>
                        <Button x:Name="CopyResponse" Content="Копировать"/>
                        <Button x:Name="SaveResponse" Content="Сохранить"/>
                    </WrapPanel>
                    <TabControl x:Name="ResponseTabs" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <TabItem Header="Тело">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock x:Name="ResponseLanguage" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                    <ComboBox x:Name="ResponseSyntax" Style="{StaticResource ValueInput}" IsEditable="True" IsReadOnly="True" Width="120" HorizontalAlignment="Right" ToolTip="Формат подсветки ответа"/>
                                </Grid>
                                <TextBox x:Name="ResponseBody" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Заголовки">
                            <TextBox x:Name="ResponseHeaders" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
            <TextBlock Grid.Row="5"
                    x:Name="Notice"
                    Text="Готов к работе  •  Ctrl+Enter — отправить  •  Ctrl+S — сохранить"
                    Foreground="{DynamicResource MutedBrush}"
                    FontSize="11"
                    Margin="0,12,0,0"/>
        </Grid>
    </Grid>
</Window>
